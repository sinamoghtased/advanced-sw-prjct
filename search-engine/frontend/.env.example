# Where the Java backend runs.
QUICKDEX_BACKEND_URL=http://localhost:8080

# Online sources for live search results, separated by commas, or "off".
# Free, no key: wikipedia, hackernews, stackexchange, arxiv (the default is all four).
# Add brave (with BRAVE_API_KEY) for results from the whole web.
QUICKDEX_WEB_SOURCES=wikipedia,hackernews,stackexchange,arxiv

# Optional: raises Stack Exchange's limit from 300 to 10,000 requests a day.
# Register an app at https://stackapps.com/apps/oauth/register to get a key.
STACKEXCHANGE_KEY=

# Needed only for brave. Get a key at https://brave.com/search/api/
BRAVE_API_KEY=
