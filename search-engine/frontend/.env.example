# Where the Java backend runs.
QUICKDEX_BACKEND_URL=http://localhost:8080

# Online sources for live search results, separated by commas, or "off" (the default).
# Phase I answers only from the backend's own corpus.txt index. To opt into live results,
# set: wikipedia, hackernews, stackexchange, arxiv (all free, no key), and brave (needs
# BRAVE_API_KEY, for results from the whole web).
QUICKDEX_WEB_SOURCES=off

# Optional: raises Stack Exchange's limit from 300 to 10,000 requests a day.
# Register an app at https://stackapps.com/apps/oauth/register to get a key.
STACKEXCHANGE_KEY=

# Needed only for brave. Get a key at https://brave.com/search/api/
BRAVE_API_KEY=
